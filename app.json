{
  "expo": {
    "name": "LingoSnap",
    "slug": "lingosnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "jsEngine": "hermes",
    "scheme": "lingosnap",
    "userInterfaceStyle": "light",

    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFDF7"
    },
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#5CB85C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lingosnap.app",
      "infoPlist": {
        "CFBundleDisplayName": "LingoSnap"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFDF7"
      },
      "package": "com.lingosnap.app",
      "versionCode": 1,
      "permissions": [
        "NOTIFICATIONS",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5CB85C"
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-secure-store",
      "expo-localization",
      "@react-native-google-signin/google-signin"
    ]
  }
}
